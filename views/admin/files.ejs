<%- include('../partials/header', { title: '文件管理', user: user }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back Button -->
  <div class="mb-6">
    <a
      href="/admin/dashboard"
      class="inline-flex items-center space-x-2 text-primary hover:text-secondary transition-colors"
    >
      <i class="bi bi-arrow-left"></i>
      <span>返回后台首页</span>
    </a>
  </div>

  <!-- Header -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 flex items-center mb-2">
      <i class="bi bi-file-earmark-text mr-3 text-primary"></i>
      文件管理
    </h1>
    <p class="text-gray-600">管理所有用户上传的文件</p>
  </div>

  <!-- 筛选器 -->
  <div class="mb-4 bg-white rounded-lg shadow p-4">
    <div class="flex items-center gap-3">
      <label class="text-sm font-medium text-gray-700">筛选用户:</label>
      <select
        id="userFilter"
        onchange="filterFiles()"
        class="px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-primary"
      >
        <option value="">全部用户</option>
        <% const uniqueUsers = [...new Set(files.map(f => f.uploaderName))]; %>
        <% uniqueUsers.forEach(username => { %>
        <option value="<%= username %>"><%= username %></option>
        <% }); %>
      </select>
      <span id="fileCount" class="text-sm text-gray-600"></span>
    </div>
  </div>

  <% if (files.length === 0) { %>
  <!-- Empty State -->
  <div class="bg-white rounded-xl shadow-md p-12 text-center">
    <i class="bi bi-inbox text-6xl text-gray-300 mb-4"></i>
    <p class="text-xl text-gray-600">暂无文件</p>
  </div>
  <% } else { %>
  <!-- Desktop Table View -->
  <div class="hidden lg:block bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            文件名
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            上传者
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            大小
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            类型
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            状态
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            上传时间
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            操作
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% files.forEach(file => { %>
        <tr
          class="hover:bg-gray-50 file-row"
          data-uploader="<%= file.uploaderName %>"
        >
          <td class="px-4 py-3">
            <div class="flex items-center">
              <i class="bi bi-file-earmark-text text-xl text-primary mr-2"></i>
              <a
                href="/files/view/<%= file.id %>"
                class="text-sm hover:text-primary hover:underline"
                ><%= file.originalName %></a
              >
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-gray-600">
            <%= file.uploaderName %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-600">
            <%= (file.size / 1024).toFixed(2) %> KB
          </td>
          <td class="px-4 py-3 text-sm text-gray-600"><%= file.mimetype %></td>
          <td class="px-4 py-3">
            <% if (file.isPublic) { %>
            <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-700"
              >公开</span
            >
            <% } else { %>
            <span class="px-2 py-1 text-xs rounded bg-gray-100 text-gray-700"
              >私有</span
            >
            <% } %>
          </td>
          <td class="px-4 py-3 text-sm text-gray-600">
            <%= new Date(file.uploadedAt).toLocaleDateString('zh-CN') %>
          </td>
          <td class="px-4 py-3 space-x-2">
            <a
              href="/files/view/<%= file.id %>"
              class="text-primary hover:text-secondary"
            >
              <i class="bi bi-eye"></i>
            </a>
            <button
              onclick="deleteFile('<%= file.id %>')"
              class="text-red-600 hover:text-red-800"
            >
              <i class="bi bi-trash"></i>
            </button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Card View -->
  <div class="lg:hidden space-y-3">
    <% files.forEach(file => { %>
    <div
      class="bg-white rounded-lg shadow p-4 file-card"
      data-uploader="<%= file.uploaderName %>"
    >
      <div class="flex items-start justify-between mb-2">
        <div class="flex items-center flex-1 min-w-0">
          <i class="bi bi-file-earmark-text text-2xl text-primary mr-2"></i>
          <div class="min-w-0 flex-1">
            <a
              href="/files/view/<%= file.id %>"
              class="text-sm font-medium truncate hover:text-primary hover:underline block"
            >
              <%= file.originalName %>
            </a>
            <p class="text-xs text-gray-500">
              <%= file.uploaderName %> · <%= (file.size / 1024).toFixed(2) %> KB
            </p>
          </div>
        </div>
        <% if (file.isPublic) { %>
        <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-700 ml-2"
          >公开</span
        >
        <% } else { %>
        <span class="px-2 py-1 text-xs rounded bg-gray-100 text-gray-700 ml-2"
          >私有</span
        >
        <% } %>
      </div>
      <div class="text-xs text-gray-500 mb-2">
        <%= new Date(file.uploadedAt).toLocaleDateString('zh-CN') %>
      </div>
      <div class="flex gap-2">
        <a
          href="/files/view/<%= file.id %>"
          class="flex-1 text-center px-3 py-2 bg-primary text-white rounded-lg hover:bg-secondary text-sm"
        >
          <i class="bi bi-eye mr-1"></i>查看
        </a>
        <button
          onclick="deleteFile('<%= file.id %>')"
          class="px-3 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 text-sm"
        >
          <i class="bi bi-trash"></i>
        </button>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div>

<script>
  function filterFiles() {
    const selectedUser = document.getElementById("userFilter").value;
    const rows = document.querySelectorAll(".file-row");
    const cards = document.querySelectorAll(".file-card");
    let visibleCount = 0;

    [...rows, ...cards].forEach((item) => {
      const uploader = item.dataset.uploader;
      if (!selectedUser || uploader === selectedUser) {
        item.style.display = "";
        visibleCount++;
      } else {
        item.style.display = "none";
      }
    });

    document.getElementById(
      "fileCount"
    ).textContent = `显示 ${visibleCount} / <%= files.length %> 个文件`;
  }

  // 初始化计数
  filterFiles();
  async function deleteFile(fileId) {
    if (!confirm("确定要删除这个文件吗？此操作不可恢复！")) {
      return;
    }

    try {
      const response = await fetch("/admin/files/" + fileId, {
        method: "DELETE",
      });

      const result = await response.json();

      if (result.success) {
        alert("删除成功！");
        location.reload();
      } else {
        alert("删除失败: " + result.message);
      }
    } catch (error) {
      alert("删除失败，请稍后重试");
    }
  }
</script>

<%- include('../partials/footer') %>
