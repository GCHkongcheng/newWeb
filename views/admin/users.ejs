<%- include('../partials/header', { title: '用户管理', user: user }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back Button -->
  <div class="mb-6">
    <a
      href="/admin/dashboard"
      class="inline-flex items-center space-x-2 text-primary hover:text-secondary transition-colors"
    >
      <i class="bi bi-arrow-left"></i>
      <span>返回后台首页</span>
    </a>
  </div>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 flex items-center">
      <i class="bi bi-people mr-3 text-primary"></i>
      用户管理
    </h1>
  </div>

  <!-- Desktop Table View -->
  <div class="hidden md:block bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            用户名
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            邮箱
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            角色
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            配额(MB)
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            注册时间
          </th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-600">
            操作
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% users.forEach(u => { %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <div class="flex items-center">
              <i class="bi bi-person-circle text-xl text-gray-400 mr-2"></i>
              <span class="text-sm"><%= u.username %></span>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-gray-600"><%= u.email %></td>
          <td class="px-4 py-3">
            <% if (u.isAdmin) { %>
            <span class="px-2 py-1 text-xs rounded bg-red-100 text-red-700"
              >管理员</span
            >
            <% } else { %>
            <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-700"
              >用户</span
            >
            <% } %>
          </td>
          <td class="px-4 py-3">
            <input
              type="number"
              value="<%= (u.storageQuota / 1024 / 1024).toFixed(0) %>"
              class="w-20 px-2 py-1 border rounded text-sm"
              onchange="updateQuota('<%= u.id %>', this.value)"
            />
          </td>
          <td class="px-4 py-3 text-sm text-gray-600">
            <%= new Date(u.createdAt).toLocaleDateString('zh-CN') %>
          </td>
          <td class="px-4 py-3">
            <% if (!u.isAdmin) { %>
            <button
              onclick="deleteUser('<%= u.id %>', '<%= u.username %>')"
              class="text-red-600 hover:text-red-800 text-sm"
            >
              <i class="bi bi-trash"></i> 删除
            </button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Card View -->
  <div class="md:hidden space-y-3">
    <% users.forEach(u => { %>
    <div class="bg-white rounded-lg shadow p-4">
      <div class="flex items-start justify-between mb-2">
        <div class="flex items-center">
          <i class="bi bi-person-circle text-2xl text-gray-400 mr-2"></i>
          <div>
            <h3 class="text-sm font-medium"><%= u.username %></h3>
            <p class="text-xs text-gray-500"><%= u.email %></p>
          </div>
        </div>
        <% if (u.isAdmin) { %>
        <span class="px-2 py-1 text-xs rounded bg-red-100 text-red-700"
          >管理员</span
        >
        <% } else { %>
        <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-700"
          >用户</span
        >
        <% } %>
      </div>
      <div class="text-xs text-gray-500 mb-2">
        注册: <%= new Date(u.createdAt).toLocaleDateString('zh-CN') %>
      </div>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <label class="text-xs">配额(MB):</label>
          <input
            type="number"
            value="<%= (u.storageQuota / 1024 / 1024).toFixed(0) %>"
            class="w-20 px-2 py-1 border rounded text-sm"
            onchange="updateQuota('<%= u.id %>', this.value)"
          />
        </div>
        <% if (!u.isAdmin) { %>
        <button
          onclick="deleteUser('<%= u.id %>', '<%= u.username %>')"
          class="px-3 py-1 bg-red-500 text-white rounded text-sm hover:bg-red-600"
        >
          删除
        </button>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
</div>

<script>
  async function updateQuota(userId, quota) {
    try {
      const response = await fetch("/admin/users/quota", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId, quota }),
      });
      const result = await response.json();
      if (result.success) {
        alert("配额更新成功");
      } else {
        alert("更新失败: " + result.message);
      }
    } catch (error) {
      alert("更新失败，请稍后重试");
    }
  }

  async function deleteUser(userId, username) {
    if (
      !confirm(
        `确定要删除用户 "${username}" 吗？这将同时删除该用户的所有文件！`
      )
    ) {
      return;
    }

    try {
      const response = await fetch("/admin/users/" + userId, {
        method: "DELETE",
      });
      const result = await response.json();
      if (result.success) {
        alert("用户已删除");
        location.reload();
      } else {
        alert("删除失败: " + result.message);
      }
    } catch (error) {
      alert("删除失败，请稍后重试");
    }
  }
</script>

<%- include('../partials/footer') %>
