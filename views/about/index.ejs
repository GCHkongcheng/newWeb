      <p class="text-sm text-gray-600">多语言语法高亮显示</p>
    </div>

    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
      <i class="bi bi-globe text-3xl text-blue-500 mb-2"></i>
      <h3 class="font-bold mb-1">公共资源</h3>
      <p class="text-sm text-gray-600">支持文件公开分享</p>
    </div>

    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
      <i class="bi bi-chat-dots text-3xl text-blue-500 mb-2"></i>
      <h3 class="font-bold mb-1">评论系统</h3>
      <p class="text-sm text-gray-600">对公共资源进行互动</p>
    </div>

    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
      <i class="bi bi-person-gear text-3xl text-blue-500 mb-2"></i>
      <h3 class="font-bold mb-1">用户中心</h3>
      <p class="text-sm text-gray-600">自主管理账户信息</p>
    </div>

    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
      <i class="bi bi-gear text-3xl text-blue-500 mb-2"></i>
      <h3 class="font-bold mb-1">后台管理</h3>
      <p class="text-sm text-gray-600">管理用户和文件数据</p>
    </div>
  </div>

  <!-- About Content -->
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="bg-gradient-to-r from-blue-400 to-blue-500 p-4">
      <h2 class="text-xl font-bold text-white flex items-center">
