      <h3 class="font-bold mb-1">安全可靠</h3>
      <p class="text-sm text-gray-600">bcrypt 加密，邮箱验证</p>
    </div>

    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
      <i class="bi bi-folder text-3xl text-blue-500 mb-2"></i>
