      <p class="text-sm text-gray-600">30天内可恢复删除文件</p>
    </div>

    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
      <i class="bi bi-search text-3xl text-blue-500 mb-2"></i>
