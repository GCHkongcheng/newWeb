    <i class="bi bi-cloud-arrow-up text-5xl text-blue-500 mb-3"></i>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">个人网盘系统</h1>
    <p class="text-gray-600">安全、便捷、高效的云存储解决方案</p>
  </div>

  <!-- Features Grid -->
  <div class="grid md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
